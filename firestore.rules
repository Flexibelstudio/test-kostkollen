rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USERS =====
    match /users/{userId} {
      allow read: if request.auth.uid == userId
                  || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
                  || exists(/databases/$(database)/documents/users/$(userId)/buddies/$(request.auth.uid));
      
      allow list: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
      
      allow create: if request.auth.uid == userId
                    && request.resource.data.get('role', null) == 'member'
                    && (request.resource.data.get('status', null) == null || request.resource.data.get('status', null) == 'pending')
                    && (request.resource.data.get('subscriptionStatus', null) == null || request.resource.data.get('subscriptionStatus', null) == 'inactive')
                    && request.resource.data.get('currentPeriodEnd', null) == null
                    && request.resource.data.get('bootcampAccess', null) == null;
      
      // Webhooken skriver via Admin SDK och går förbi dessa regler – ingen auth==null-gren behövs
      
      allow update: if (request.auth.uid == userId
                        && request.resource.data.get('role', null) == resource.data.get('role', null)
                        && request.resource.data.get('status', null) == resource.data.get('status', null)
                        && request.resource.data.get('subscriptionStatus', null) == resource.data.get('subscriptionStatus', null)
                        && request.resource.data.get('bootcampAccess', null) == resource.data.get('bootcampAccess', null)
                        && request.resource.data.get('currentPeriodEnd', null) == resource.data.get('currentPeriodEnd', null))
                    || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
      
      allow delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';

      // ===== SUBCOLLECTION: buddies =====
      match /buddies/{buddyUid} {
        allow read: if request.auth.uid == userId
                    || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
                    || request.auth.uid == buddyUid;
        allow write: if request.auth.uid == userId;
      }

      // ===== pastDaySummaries =====
      match /pastDaySummaries/{docId} {
        allow read, list: if request.auth.uid == userId
                          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
                          || exists(/databases/$(database)/documents/users/$(userId)/buddies/$(request.auth.uid));
        allow write: if request.auth.uid == userId;
      }

      // ===== ANDRA SUBCOLLECTIONS (timelineEvents, achievements, etc) =====
      match /{subcollection}/{docId} {
        allow read, list: if request.auth.uid == userId
                          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
                          || (
                              subcollection in [
                                "timelineEvents",
                                "achievements",
                                "weightLogs",
                                "courseProgress"
                              ]
                              && exists(/databases/$(database)/documents/users/$(userId)/buddies/$(request.auth.uid))
                          );
        allow write: if request.auth.uid == userId;
      }
    }

    // ===== PUBLIC PROFILES =====
    match /publicProfiles/{userId} {
      allow read, list: if request.auth.uid != null;
      allow create, update: if request.auth.uid == userId
                            && (
                              !('isCoach' in request.resource.data)
                              || request.resource.data.isCoach == (get(/databases/$(database)/documents/users/$(userId)).data.role == 'coach')
                            );
      allow delete: if request.auth.uid == userId;
    }

    // ===== COMMUNITYTIMELINE =====
    match /communityTimeline/{eventId} {
      allow get: if request.auth.uid != null;
      allow list: if request.auth.uid != null;
      allow create: if request.auth.uid != null && (
        request.resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
      );
      
      // UPPDATERAD: Författaren eller coach får ändra inlägget (dock får userId, timestamp och bootcampId aldrig ändras).
      // Övriga som har läsrätt/reaktionsrätt får ENDAST ändra reaktionsfält (reactions, likes).
      allow update: if request.auth.uid != null && (
        (
          (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach') &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'timestamp', 'bootcampId'])
        ) ||
        (
          (
            request.auth.uid in resource.data.visibleTo ||
            'GLOBAL' in resource.data.visibleTo ||
            resource.data.isGlobal == true ||
            (resource.data.bootcampId != null && exists(/databases/$(database)/documents/bootcampCohorts/$(resource.data.bootcampId)/participants/$(request.auth.uid)))
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'likes'])
        )
      );
      
      allow delete: if request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';

      match /comments/{commentId} {
        allow get: if request.auth.uid != null;
        allow list: if request.auth.uid != null;
        allow create: if request.auth.uid != null && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if request.auth.uid == resource.data.authorUid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';

        match /likes/{userId} {
          allow get: if request.auth.uid != null;
          allow list: if request.auth.uid != null;
          allow create, delete: if request.auth.uid == userId;
        }
      }
    }

    // ===== PEPPKOMPIS-REQUESTS =====
    match /peppkompisRequests/{requestId} {
      allow read: if request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid;
      allow create: if request.auth.uid == request.resource.data.fromUid;
      allow update: if request.auth.uid == resource.data.toUid;
      allow delete: if request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid;
    }

    // ===== CHATS =====
    match /chats/{chatId} {
      // Tillåt läsning om användaren är medlem ELLER om det är ett öppet rum ELLER om användaren är coach
      allow read: if request.auth.uid != null && (
        request.auth.uid in resource.data.members || 
        resource.data.type == 'public_room' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
      );
      
      // Tillåt skapande om man är inloggad och lägger till sig själv i både members och admins
      allow create: if request.auth.uid != null &&
                    request.auth.uid in request.resource.data.members &&
                    request.auth.uid in request.resource.data.admins;
      
      // Tillåt uppdatering baserat på roll och åtgärd:
      // 1. Admins och coacher kan uppdatera rumsinställningar, medlemmar, admins osv.
      // 2. Befintliga medlemmar får uppdatera lastMessage och sina egna memberSettings, eller lämna chatten (ta bort sig själv ur members).
      // 3. I öppna rum (public_room) får en användare gå med (lägga till enbart sig själv i members eller pendingMembers) eller lämna (ta bort enbart sig själv ur members).
      allow update: if request.auth.uid != null && (
        // Admin eller coach
        request.auth.uid in resource.data.admins ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach' ||
        
        // Befintlig medlem uppdaterar meddelandestatus / inställningar
        (
          request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'memberSettings'])
        ) ||
        
        // Befintlig medlem lämnar chatten
        (
          request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberSettings']) &&
          request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
        ) ||
        
        // Öppet rum (public_room): användare går med direkt
        (
          resource.data.type == 'public_room' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberSettings']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.removeAll(resource.data.members) == [request.auth.uid]
        ) ||
        
        // Öppet rum (public_room): användare begär att få gå med (pendingMembers)
        (
          resource.data.type == 'public_room' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingMembers']) &&
          request.resource.data.pendingMembers.hasAll(resource.data.pendingMembers) &&
          request.resource.data.pendingMembers.removeAll(resource.data.pendingMembers) == [request.auth.uid]
        )
      );
      
      allow delete: if request.auth.uid in resource.data.admins || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';

      match /messages/{messageId} {
        // Endast medlemmar eller coacher får läsa meddelanden
        allow read: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
                    || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
        
        // Endast medlemmar eller coacher får skicka meddelanden, och måste vara avsändaren
        allow create: if (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
                          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach')
                      && request.auth.uid == request.resource.data.senderId;
                      
        // Avsändaren eller coach får redigera/radera meddelandet (dock får senderId och timestamp aldrig ändras).
        // Övriga medlemmar i chatten får ENDAST ändra reaktionsfält (reactions).
        allow update: if request.auth.uid != null && (
          (
            (request.auth.uid == resource.data.senderId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach') &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'timestamp'])
          ) ||
          (
            (
              request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          )
        );
        allow delete: if request.auth.uid == resource.data.senderId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
      }
    }

    // ===== INTERAKTIONER (pepp/likes) =====
    match /achievementInteractions/{userId}/{doc=**} {
      allow read: if request.auth.uid == userId
                  || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
                  || exists(/databases/$(database)/documents/users/$(userId)/buddies/$(request.auth.uid));
      allow write: if request.auth.uid != userId
                   && exists(/databases/$(database)/documents/users/$(userId)/buddies/$(request.auth.uid));
    }

    // ===== COLLECTION GROUP QUERIES =====
    match /{path=**}/participants/{docId} {
      allow read: if request.auth.uid != null && (
        docId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
      );
      // För collectionGroup queries måste vi tillåta list separat om vi filtrerar
      allow list: if request.auth.uid != null;
    }

    // ===== BOOTCAMP CONTENT LIBRARY =====
    match /postTemplates/{templateId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }

    match /scheduledPosts/{postId} {
      allow read: if request.auth.uid != null;
      allow create, update, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
    }

    // ===== BOOTCAMP COHORTS =====
    match /bootcampCohorts/{cohortId} {
      // Alla inloggade kan läsa trupper (för att kunna gå med via kod)
      allow read: if request.auth.uid != null;
      // Endast coacher kan skapa och uppdatera trupper
      allow create, update, delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';

      // ===== POSTS (Truppens flöde) =====
      match /posts/{postId} {
        // Deltagare i truppen eller coacher kan läsa inlägg i en bootcamp
        allow read: if request.auth.uid != null && (
          exists(/databases/$(database)/documents/bootcampCohorts/$(cohortId)/participants/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
        );
        // Endast deltagare i truppen eller coach kan skapa inlägg, och authorUid måste matcha inloggad användare
        allow create: if request.auth.uid != null && (
          exists(/databases/$(database)/documents/bootcampCohorts/$(cohortId)/participants/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
        ) && request.resource.data.authorUid == request.auth.uid;
        
        // Författaren eller coach får uppdatera inlägget (men authorUid, timestamp och cohortId får aldrig ändras).
        // Övriga deltagare i truppen får ENDAST ändra gilla-, reaktions- och kommentarsfält (likes, reactions, comments).
        allow update: if request.auth.uid != null && (
          (
            (request.auth.uid == resource.data.authorUid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach') &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorUid', 'timestamp', 'cohortId'])
          ) ||
          (
            (
              exists(/databases/$(database)/documents/bootcampCohorts/$(cohortId)/participants/$(request.auth.uid)) ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach'
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'reactions', 'comments'])
          )
        );
        // Endast författaren eller coach kan ta bort
        allow delete: if request.auth.uid == resource.data.authorUid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
      }

      // ===== PARTICIPANTS =====
      match /participants/{userId} {
        // Coacher och deltagaren själv kan läsa
        allow read: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
        // Deltagaren kan skapa (när de går med) och uppdatera sin egen data
        allow create, update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
        allow delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';

        // ===== EVENING REPORTS =====
        match /eveningReports/{date} {
          allow read: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
          allow create, update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
          allow delete: if get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach';
        }
      }
    }

    // ===== CHALLENGES =====
    match /challenges/{challengeId} {
      // Endast deltagare i utmaningen får läsa och skriva i den
      allow get: if request.auth.uid != null && request.auth.uid in resource.data.participantUids;
      allow list: if request.auth.uid != null && resource.data.participantUids.hasAny([request.auth.uid]);
      allow create: if request.auth.uid != null && request.auth.uid in request.resource.data.participantUids;
      allow update: if request.auth.uid != null && request.auth.uid in resource.data.participantUids;
      allow delete: if request.auth.uid != null && request.auth.uid == resource.data.createdBy;
    }
  }
}
